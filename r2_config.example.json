{
  "account_id": "your-cloudflare-account-id",
  "access_key_id": "your-r2-access-key-id",
  "secret_access_key": "your-r2-secret-access-key",
  "bucket": "novelai-tag-assets",
  "public_base_url": "https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev",
  "region": "auto",
  "http_pool_enabled": true,
  "http_pool_max_connections": 16,
  "http_pool_idle_timeout": 60,
  "data_release_format": "dual",
  "image_prefix": "images",
  "original_prefix": "originals",
  "cache_control": "public, max-age=31536000, immutable",
  "data_prefix": "data",
  "data_public_base_url": "https://assets.quicktagcloud.com/data",
  "site_origin": "https://novelai.quicktagcloud.com"
}
